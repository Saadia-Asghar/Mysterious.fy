# Local integration service. Copy to .env if you want to override the defaults.
# Do not put real passwords, tokens, or device addresses in Git.

NMS_DATABASE_PATH=data/nms.sqlite
NMS_PROFILES_DIR=device-profiles
NMS_HOST=127.0.0.1
NMS_PORT=8000
# Shared secret Zabbix sends as X-NMS-Webhook-Token. Empty = not required (local dev only).
NMS_ZABBIX_WEBHOOK_TOKEN=
# osTicket ticketing (M6). Leave URL or key empty to disable ticket creation.
NMS_OSTICKET_URL=http://localhost:8081
NMS_OSTICKET_API_KEY=change_me
NMS_OSTICKET_REPORTER_EMAIL=nms@example.com
# Lowest incident severity that opens a ticket: not_classified, information, warning, average, high, disaster
NMS_TICKET_MIN_SEVERITY=warning
# Zabbix API for post-remediation verification (M12). Token: Zabbix UI > Users > API tokens.
NMS_ZABBIX_API_URL=http://localhost:8080/api_jsonrpc.php
NMS_ZABBIX_API_TOKEN=change_me
# Seconds after an action before an unhealthy result escalates to a human ticket
NMS_VERIFY_TIMEOUT_SECONDS=300

# --- M1 core services (docker/docker-compose.yml). Replace every change_me value in your own .env ---
TZ=Asia/Karachi
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change_me
# Zabbix web Admin password, used only by scripts/zabbix_bootstrap.py (asked if unset)
ZABBIX_ADMIN_PASSWORD=change_me
ZABBIX_WEB_PORT=8080
# Create in Zabbix UI (Users > API tokens) after first login, then restart grafana.
ZABBIX_API_TOKEN=change_me
GRAFANA_PORT=3000
# Where Grafana (in Docker) reaches the integration API running on the host
NMS_API_URL=http://host.docker.internal:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
OSTICKET_IMAGE=tiredofit/osticket:latest
OSTICKET_PORT=8081
OSTICKET_DB_USER=osticket
OSTICKET_DB_PASSWORD=change_me
OSTICKET_DB_ROOT_PASSWORD=change_me
OSTICKET_ADMIN_EMAIL=admin@example.com
OSTICKET_ADMIN_PASSWORD=change_me
NMS_DB_USER=nms
NMS_DB_PASSWORD=change_me
NMS_DB_PORT=5433

# Signs customer portal login tokens (/app). Set a long random value so logins survive restarts.
NMS_PORTAL_SECRET=change_me

# Background sync: correlate new events, verify fixes, close incidents Zabbix sees recovered (0 = off)
NMS_AUTO_SYNC_SECONDS=30

# Links in emails point here (the address users open)
NMS_PUBLIC_URL=http://localhost:8000
# Email alerts for tickets; leave NMS_SMTP_HOST empty to turn them off
NMS_SMTP_HOST=
NMS_SMTP_PORT=587
NMS_SMTP_USER=
NMS_SMTP_PASSWORD=change_me
NMS_SMTP_FROM=
NMS_SMTP_STARTTLS=true
# Automatic database backups while the background loop runs (0 = off)
NMS_BACKUP_HOURS=24
NMS_BACKUP_KEEP=30
NMS_BACKUP_DIR=
