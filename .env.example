# Local integration service. Copy to .env if you want to override the defaults.
# Do not put real passwords, tokens, or device addresses in Git.

NMS_DATABASE_PATH=data/nms.sqlite
NMS_PROFILES_DIR=device-profiles
NMS_HOST=127.0.0.1
NMS_PORT=8000
# Shared secret Zabbix sends as X-NMS-Webhook-Token. Empty = not required (local dev only).
NMS_ZABBIX_WEBHOOK_TOKEN=
# osTicket ticketing (M6). Leave URL or key empty to disable ticket creation.
NMS_OSTICKET_URL=http://localhost:8081
NMS_OSTICKET_API_KEY=change_me
NMS_OSTICKET_REPORTER_EMAIL=nms@example.com
# Lowest incident severity that opens a ticket: not_classified, information, warning, average, high, disaster
NMS_TICKET_MIN_SEVERITY=warning

# --- M1 core services (docker/docker-compose.yml). Replace every change_me value in your own .env ---
TZ=Asia/Karachi
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change_me
ZABBIX_WEB_PORT=8080
# Create in Zabbix UI (Users > API tokens) after first login, then restart grafana.
ZABBIX_API_TOKEN=change_me
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
OSTICKET_IMAGE=tiredofit/osticket:latest
OSTICKET_PORT=8081
OSTICKET_DB_USER=osticket
OSTICKET_DB_PASSWORD=change_me
OSTICKET_DB_ROOT_PASSWORD=change_me
OSTICKET_ADMIN_EMAIL=admin@example.com
OSTICKET_ADMIN_PASSWORD=change_me
NMS_DB_USER=nms
NMS_DB_PASSWORD=change_me
NMS_DB_PORT=5433
